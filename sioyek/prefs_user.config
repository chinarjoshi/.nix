# sioyek user preferences. Overrides prefs.config shipped in the Nix store.
# Reference for every option: the prefs.config next to the binary, i.e.
#   $(nix build --no-link --print-out-paths nixpkgs#sioyek)/Applications/sioyek.app/Contents/MacOS/prefs.config

# Dark mode on at launch. `default_dark_mode` also exists but is deprecated
# upstream in favour of driving it through startup_commands.
startup_commands    toggle_dark_mode;fit_to_page_width_smart

# Preview-style refit, but margin-cropped. `resize_command` is an undocumented
# macro hook fired at the end of MainWidget::resizeEvent, so any resize --
# Rectangle snapping a half, a mouse drag, fullscreen -- retriggers the fit.
# No keybinding, and nothing to remember to press.
#
# Sioyek already refits on resize via its internal auto-resize mode, but that
# path calls the plain fit_to_page_width(). It runs earlier in the same
# resizeEvent, so this hook lands after it and wins.
resize_command      fit_to_page_width_smart

# Inverted-page colours. Matched to tokyonight-night (#1a1b26) so the PDF and
# the editor agree. Contrast <1.0 softens pure-white text to reduce glare.
dark_mode_background_color    0.102 0.106 0.149
dark_mode_contrast            0.85

# Application chrome behind the page, so nothing white frames the document.
background_color              0.102 0.106 0.149

# F8 toggles dark mode at runtime (see keys.config). Uncomment to also get a
# third "custom colour" scheme on F9 for papers that invert badly (scanned
# pages, dark figures):
# custom_background_color   0.180 0.204 0.251
# custom_text_color         0.847 0.870 0.913
